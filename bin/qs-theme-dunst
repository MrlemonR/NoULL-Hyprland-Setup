#!/usr/bin/env python3
"""dunstrc içindeki renkleri etkin temaya göre günceller.

dunst 'include' desteklemiyor, bu yüzden dosyayı yerinde düzenliyoruz:
sadece bilinen (bölüm, anahtar) çiftlerinin değerini değiştirip geri kalan
her şeyi olduğu gibi bırakıyoruz.

Kullanım: qs-theme-dunst <tema-adı>
"""

import json
import os
import re
import subprocess
import sys

PALETTES_FILE = os.path.expanduser("~/.config/quickshell/palettes.json")


def load_palette(theme):
    """Renkler tek kaynaktan: ~/.config/quickshell/palettes.json (qs-palette).

    Yeni tema eklerken burayı değil o dosyayı düzenlemek yeterli.
    """
    try:
        with open(PALETTES_FILE, encoding="utf-8") as handle:
            raw = json.load(handle).get(theme)
    except (OSError, ValueError):
        return None
    if raw is None:
        return None
    try:
        return {
            "base": raw["base"], "text": raw["text"], "subtext": raw["subtext0"],
            "surface1": raw["surface1"], "surface2": raw["surface2"],
            "mauve": raw["mauve"], "blue": raw["blue"], "red": raw["red"],
        }
    except KeyError:
        return None
# (bölüm, anahtar) -> palet anahtarı
RULES = {
    ("global", "background"): "base",
    ("global", "foreground"): "text",
    ("global", "frame_color"): "mauve",
    ("urgency_low", "background"): "base",
    ("urgency_low", "foreground"): "subtext",
    ("urgency_low", "frame_color"): "surface2",
    ("urgency_normal", "background"): "base",
    ("urgency_normal", "foreground"): "text",
    ("urgency_normal", "frame_color"): "mauve",
    ("urgency_normal", "highlight"): "mauve",
    ("urgency_critical", "background"): "base",
    ("urgency_critical", "foreground"): "red",
    ("urgency_critical", "frame_color"): "red",
    ("qs_reminder", "frame_color"): "blue",
    ("qs_reminder", "highlight"): "blue",
}


def main():
    if len(sys.argv) < 2:
        sys.exit("kullanım: qs-theme-dunst <tema>")

    theme = sys.argv[1]
    palette = load_palette(theme)
    if palette is None:
        sys.exit(f"qs-theme-dunst: bilinmeyen tema '{theme}'")

    path = os.path.expanduser("~/.config/dunst/dunstrc")
    if not os.path.isfile(path):
        print("dunst: dunstrc bulunamadı, atlandı")
        return

    with open(path, encoding="utf-8") as handle:
        lines = handle.readlines()

    section = ""
    changed = 0

    for index, line in enumerate(lines):
        header = re.match(r"^\s*\[([^\]]+)\]", line)
        if header:
            section = header.group(1)
            continue

        assignment = re.match(r"^(\s*)([a-z_]+)(\s*=\s*)(.*)$", line)
        if not assignment:
            continue

        key = assignment.group(2)
        palette_key = RULES.get((section, key))
        if palette_key is None:
            continue

        value = palette[palette_key]
        new_line = f'{assignment.group(1)}{key}{assignment.group(3)}"{value}"\n'
        if new_line != line:
            lines[index] = new_line
            changed += 1

    with open(path, "w", encoding="utf-8") as handle:
        handle.writelines(lines)

    subprocess.run(["dunstctl", "reload"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"dunst: {changed} renk güncellendi ve yeniden yüklendi")


if __name__ == "__main__":
    main()
