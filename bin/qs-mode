#!/usr/bin/env bash
#
# Performans / normal mod.
#
#   qs-mode performance   -> görsel ekstraları kapat, kaynak kullanımını düşür
#   qs-mode normal        -> her şeyi geri aç
#   qs-mode toggle        -> ikisi arasında geçiş
#   qs-mode status        -> etkin mod
#
# Performans modunda:
#   - duvar kağıdı süreçleri kapanıyor (mpvpaper ~250MB PSS, hyprpaper ~44MB)
#     ve onları izleyen qs-wallpaper-watch de gereksiz kaldığı için duruyor,
#   - blur, gölge, pencere saydamlığı, köşe yuvarlama, animasyonlar,
#     özel workspace karartması kapanıyor (bkz. config/effects.lua),
#   - bar'ın yoklama aralıkları uzuyor (bkz. PerfMode.qml).
#
# Quickshell bar'ı BİLEREK açık kalıyor — kaynak kullanımını oradan izliyoruz.
#
# DİKKAT: monitörün tazeleme hızına dokunmuyoruz. 180Hz'i 60'a düşürmek
# derleyicinin CPU'sunu yarıya indiriyor (ölçüldü: 9.2% -> 3.5%) ama oyunda
# performansın kendisi o; kullanıcı isteği üzerine kapsam dışı.

set -u

STATE="${XDG_RUNTIME_DIR:-/run/user/1000}/qs-mode.performance"
PERF_LUA="$HOME/.config/hypr/config/effects.lua"
WALLPAPER_WATCH="$HOME/.local/bin/qs-wallpaper-watch"

# Bar'a haber ver (kurulu değilse ya da kapalıysa sessiz geç)
notify_bar() {
    qs -c topbar ipc call mode "$1" >/dev/null 2>&1 || true
}

perf_on() {
    # DİKKAT: bayrak ÖNCE yazılıyor — effects.lua varlığına bakıyor.
    touch "$STATE"

    pkill -x mpvpaper 2>/dev/null || true
    pkill -x hyprpaper 2>/dev/null || true
    # Duvar kağıdı yokken izlemenin de anlamı yok
    pkill -f "$WALLPAPER_WATCH" 2>/dev/null || true

    # Ayarların tek kaynağı effects.lua; hyprctl reload sonrası da aynı
    # dosya çalışıyor, böylece mod reload'da iptal olmuyor.
    hyprctl eval "dofile('$PERF_LUA')" >/dev/null

    notify_bar performance
    echo "mod: performance (duvar kağıdı, blur, gölge, animasyon kapalı)"
}

perf_off() {
    rm -f "$STATE"

    # decorations.lua + animations.lua'daki değerler geri gelsin.
    # effects.lua da yeniden çalışıyor ama bayrak silindiği için etkisiz.
    hyprctl reload >/dev/null

    if ! pgrep -x hyprpaper >/dev/null 2>&1; then
        hyprctl dispatch 'hl.dsp.exec_cmd("hyprpaper")' >/dev/null
    fi
    if ! pgrep -f "$WALLPAPER_WATCH" >/dev/null 2>&1; then
        hyprctl dispatch "hl.dsp.exec_cmd(\"$WALLPAPER_WATCH\")" >/dev/null
    fi
    # Etkin temanın duvar kağıdını (video ise mpvpaper ile) geri koy
    "$HOME/.local/bin/qs-wallpaper" restore >/dev/null 2>&1 &

    notify_bar normal
    echo "mod: normal"
}

case "${1:-status}" in
    performance) perf_on ;;
    normal)      perf_off ;;
    toggle)      [[ -e "$STATE" ]] && perf_off || perf_on ;;
    status)      [[ -e "$STATE" ]] && echo performance || echo normal ;;
    *) echo "kullanım: qs-mode performance|normal|toggle|status" >&2; exit 1 ;;
esac
