#!/usr/bin/env bash
#
# Performans / normal mod.
#
#   qs-mode performance   -> görsel ekstraları kapat, kaynak kullanımını düşür
#   qs-mode normal        -> her şeyi geri aç
#   qs-mode toggle        -> ikisi arasında geçiş
#   qs-mode status        -> etkin mod
#
# Performans modunda kapananlar: duvar kağıdı süreçleri (hyprpaper, mpvpaper),
# blur, gölge, pencere saydamlığı, animasyonlar, özel workspace karartması.
# Quickshell bar'ı BİLEREK açık kalıyor — kaynak kullanımını oradan izliyoruz.

set -u

STATE="${XDG_RUNTIME_DIR:-/run/user/1000}/qs-mode.performance"

perf_on() {
    pkill -x mpvpaper 2>/dev/null || true
    pkill -x hyprpaper 2>/dev/null || true

    hyprctl eval 'hl.config({
        animations = { enabled = false },
        decoration = {
            blur = { enabled = false },
            shadow = { enabled = false },
            active_opacity = 1,
            inactive_opacity = 1,
            dim_special = 0,
            dim_inactive = false,
        },
        misc = { vfr = true, disable_hyprland_logo = true },
    })' >/dev/null

    touch "$STATE"
    echo "mod: performance (duvar kağıdı, blur, gölge, animasyon kapalı)"
}

perf_off() {
    rm -f "$STATE"

    # decorations.lua + animations.lua'daki değerler geri gelsin
    hyprctl reload >/dev/null

    if ! pgrep -x hyprpaper >/dev/null 2>&1; then
        hyprctl dispatch 'hl.dsp.exec_cmd("hyprpaper")' >/dev/null
    fi
    # Etkin temanın duvar kağıdını (video ise mpvpaper ile) geri koy
    "$HOME/.local/bin/qs-wallpaper" restore >/dev/null 2>&1 &

    echo "mod: normal"
}

case "${1:-status}" in
    performance) perf_on ;;
    normal)      perf_off ;;
    toggle)      [[ -e "$STATE" ]] && perf_off || perf_on ;;
    status)      [[ -e "$STATE" ]] && echo performance || echo normal ;;
    *) echo "kullanım: qs-mode performance|normal|toggle|status" >&2; exit 1 ;;
esac
