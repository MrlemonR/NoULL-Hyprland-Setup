#!/usr/bin/env python3
"""Kvantum (Qt/KDE) teması uygular; monochrome için tema üretir.

Hazır bir monochrome Kvantum teması olmadığı için mevcut catppuccin temasını
kopyalayıp içindeki bütün renkleri gri tonlarına çeviriyoruz — .kvconfig ve
.svg dosyalarındaki hex renkleri parlaklık değerine indiriyoruz.

Kullanım: qs-theme-kvantum <tema>
"""

import json
import os
import re
import shutil
import sys

KV_DIR = os.path.expanduser("~/.config/Kvantum")
SOURCE = "catppuccin-mocha-mauve"
GENERATED_PREFIX = "qs-"
PALETTES_FILE = os.path.expanduser("~/.config/quickshell/lemonrice.json")

# Kaynak tema catppuccin olduğu için onun hexleri hedef paletin karşılıklarıyla
# değiştiriliyor. Eşleşmeyen renkler (gölge, vurgu tonları) olduğu gibi kalıyor.
SOURCE_KEYS = {
    "base": "#1e1e2e", "mantle": "#181825", "crust": "#11111b",
    "surface0": "#313244", "surface1": "#45475a", "surface2": "#585b70",
    "overlay0": "#6c7086", "subtext0": "#a6adc8", "subtext1": "#bac2de",
    "text": "#cdd6f4", "mauve": "#cba6f7", "blue": "#89b4fa", "red": "#f38ba8",
    "green": "#a6e3a1", "yellow": "#f9e2af", "peach": "#fab387",
    "pink": "#f5c2e7", "cyan": "#94e2d5",
    # Catppuccin's remaining ramp. Without these they survive the substitution
    # untouched — `text.normal.color=#9399b2` (overlay2) is what left Dolphin's
    # sidebar and every icon-view filename unreadable on the first light theme.
    "overlay0#1": "#7f849c",   # overlay1
    "overlay0#2": "#9399b2",   # overlay2
    "mauve#1": "#b4befe",      # lavender
    "blue#1": "#74c7ec",       # sapphire
    "blue#2": "#89dceb",       # sky
    "cyan#1": "#94e2d5",       # teal
    "red#1": "#eba0ac",        # maroon
    "pink#1": "#f2cdcd",       # flamingo
    "pink#2": "#f5e0dc",       # rosewater
}

# Kvantum also writes 8-digit #rrggbbaa (highlight.color is one), which a
# 6-digit-only pattern walked straight past.
HEX = re.compile(r"#([0-9a-fA-F]{8}|[0-9a-fA-F]{6})\b")


def recolor(match, palette):
    """Catppuccin hexini hedef paletin karşılığıyla değiştir."""
    raw = match.group(1).lower()
    alpha = raw[6:] if len(raw) == 8 else ""
    value = "#" + raw[:6]
    for key, source_hex in SOURCE_KEYS.items():
        if value == source_hex:
            # "mauve#1" gibi anahtarlar aynı palet rengine birden çok kaynak
            # rengi bağlıyor.
            return palette.get(key.split("#")[0], value) + alpha
    return "#" + raw


def relative_luminance(value):
    """WCAG'in gamma düzeltmeli parlaklığı.

    Ham (0.2126R+0.7152G+0.0722B)/255 ile karıştırılmamalı: o, okunurluk için
    yanıltıyor. #7fb0c9 açık zeminde ham farkı 0.29 verip eşiği geçiyordu ama
    gerçek kontrastı 2.1:1, yani okunmuyordu — Dolphin'in kenar çubuğu tam
    olarak bu yüzden iki denemede düzelmedi.
    """
    v = value.lstrip("#")[:6]
    out = []
    for i in (0, 2, 4):
        c = int(v[i:i + 2], 16) / 255
        out.append(c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4)
    return 0.2126 * out[0] + 0.7152 * out[1] + 0.0722 * out[2]


def contrast(a, b):
    """WCAG kontrast oranı, 1:1 ile 21:1 arası."""
    la, lb = relative_luminance(a), relative_luminance(b)
    if la < lb:
        la, lb = lb, la
    return (la + 0.05) / (lb + 0.05)

def luminance(value):
    v = value.lstrip("#")[:6]
    r, g, b = (int(v[i:i + 2], 16) for i in (0, 2, 4))
    return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255


def fix_text_contrast(content, palette):
    """Yazı renklerini zemine göre okunur hale getir.

    Hex eşleştirme rengin YERİNİ koruyor ama ANLAMINI korumuyor: kaynak
    temada `mantle` "vurgu üzerine koyu yazı" demekken bizim açık paletimizde
    mantle açık bir renk, yani aynı slot açık-üstüne-açık oluyor. Eşleşmeyen
    renkler de olduğu gibi kalıyor. İkisinin sonucu da aynı: okunmayan yazı.

    Bu yüzden adı `text` geçen anahtarlar sonradan kontrast için denetleniyor;
    zeminden yeterince ayrılmıyorsa paletin karşı ucuna çekiliyor.

    `disabled` de dahil, ayrı bir eşikle. İlk denemede onu dışarıda bırakmıştım
    ("soluk olması gerekiyor" diye) ve Dolphin'in kenar çubuğu okunmaz kalmayı
    sürdürdü: kaynak temanın disabled rengi surface2'ye eşleniyor, açık palette
    o da zeminden yalnızca 0.25 ayrılıyor. Soluk ile okunmaz arasındaki fark
    tam olarak bu — soluk hedefi overlay0.
    """
    base_lum = luminance(palette["base"])
    dark, light = palette["text"], palette["base"]
    if luminance(dark) > luminance(light):
        dark, light = light, dark
    readable = dark if base_lum > 0.5 else light

    base = palette["base"]

    def repl(match):
        key, value = match.group(1), match.group(2)
        dim = "disabled" in key
        # 4.5:1 normal metin, 3:1 bilerek soluk olan — WCAG'in eşikleri.
        floor = 3.0 if dim else 4.5
        if contrast(value, base) >= floor:
            return match.group(0)
        target = palette["overlay0"] if dim else readable
        if contrast(target, base) < floor:
            target = palette["subtext0"] if dim else readable
        return f"{key}={target}"

    return re.sub(r"(?m)^([\w.]*text[\w.]*color)=(#[0-9a-fA-F]{6,8})", repl, content)


def to_gray(match):
    value = match.group(1)
    r, g, b = (int(value[i:i + 2], 16) for i in (0, 2, 4))
    # Göz duyarlılığına göre parlaklık
    level = round(0.2126 * r + 0.7152 * g + 0.0722 * b)
    level = max(0, min(255, level))
    return "#{0:02x}{0:02x}{0:02x}".format(level)


def build_theme(theme, palette):
    generated = GENERATED_PREFIX + theme
    src = os.path.join(KV_DIR, SOURCE)
    dst = os.path.join(KV_DIR, generated)

    if not os.path.isdir(src):
        return None

    os.makedirs(dst, exist_ok=True)

    for name in os.listdir(src):
        src_file = os.path.join(src, name)
        if not os.path.isfile(src_file):
            continue

        # Dosya adları tema adıyla eşleşmek zorunda
        new_name = name.replace(SOURCE, generated)
        dst_file = os.path.join(dst, new_name)

        if name.endswith((".kvconfig", ".svg")):
            with open(src_file, encoding="utf-8", errors="replace") as handle:
                content = handle.read()
            content = HEX.sub(lambda m: recolor(m, palette), content)
            if name.endswith(".kvconfig"):
                content = fix_text_contrast(content, palette)
                content = content.replace(SOURCE, generated)
            with open(dst_file, "w", encoding="utf-8") as handle:
                handle.write(content)
        else:
            shutil.copy2(src_file, dst_file)

    return dst


def set_theme(name):
    conf = os.path.join(KV_DIR, "kvantum.kvconfig")
    os.makedirs(KV_DIR, exist_ok=True)
    with open(conf, "w", encoding="utf-8") as handle:
        handle.write(f"[General]\ntheme={name}\n")


def main():
    if len(sys.argv) < 2:
        sys.exit("kullanım: qs-theme-kvantum <tema>")

    theme = sys.argv[1]

    try:
        with open(PALETTES_FILE, encoding="utf-8") as handle:
            palette = json.load(handle)["palettes"].get(theme)
    except (OSError, ValueError):
        palette = None

    if palette is None:
        print(f"kvantum: '{theme}' için palet yok, atlandı")
        return

    # Kurulu hazır tema varsa onu kullan (catppuccin)
    ready = palette.get("kvantumTheme") or ""
    if ready and os.path.isdir(os.path.join(KV_DIR, ready)):
        set_theme(ready)
        print(f"kvantum: {ready}")
        return

    # Yoksa catppuccin temasını hedef paletle yeniden renklendirip üret.
    # DİKKAT: bu olmadan Kvantum catppuccin renklerinde kalıyor ve Qt/KDE
    # uygulamaları (gwenview, featherpad) tema değişimini hiç görmüyor.
    generated = build_theme(theme, palette)
    if generated is None:
        print(f"kvantum: kaynak tema '{SOURCE}' yok, üretilemedi")
        return
    set_theme(os.path.basename(generated))
    print(f"kvantum: {os.path.basename(generated)} üretildi ve etkinleştirildi")


if __name__ == "__main__":
    main()
