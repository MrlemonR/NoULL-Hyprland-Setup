#!/usr/bin/env python3
"""Tam ekran/maximize pencere varken animasyonlu duvar kağıdını duraklatır.

Nasılsa görünmüyor: video boşuna GPU/CPU yiyordu. Hyprland'in olay soketini
dinleyip mpv'nin IPC soketine pause gönderiyoruz (mpvpaper'ı öldürmüyoruz,
yoksa geri dönüşte baştan yüklenirdi).

Hyprland autostart'tan çalışıyor.
"""
import json, os, socket, string, subprocess, sys

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000")
HIS = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
EVENTS = f"{RUNTIME}/hypr/{HIS}/.socket2.sock"
MPV_SOCK = f"{RUNTIME}/qs-mpvpaper.sock"
WATCHED = ("fullscreen>>", "openwindow>>", "closewindow>>", "workspace>>",
           "focusedmon>>", "movewindow>>")


def mpv(pause):
    """mpv IPC: soket yoksa animasyonlu duvar kağıdı yok demektir, sessiz geç."""
    if not os.path.exists(MPV_SOCK):
        return
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(MPV_SOCK)
            cmd = {"command": ["set_property", "pause", bool(pause)]}
            s.sendall((json.dumps(cmd) + "\n").encode())
    except OSError:
        pass


# Eski sürümde boşluksuz mod globaldi ve tek bir bayrak dosyası vardı.
# qs-maximize ilk basışta onu temizliyor; o ana kadar gerçekten global
# olduğu için burada hâlâ hesaba katıyoruz.
LEGACY_STATE = f"{RUNTIME}/qs-maximize.on"

ASCII_ALNUM = set(string.ascii_letters + string.digits)


def state_path(ws_name):
    """qs-maximize'in workspace başına tuttuğu durum dosyası.

    Ad temizleme qs-maximize'deki `tr -c '[:alnum:]' '_'` ile birebir aynı
    olmalı, yoksa iki taraf farklı dosyaya bakar. tr bayt bayt çalıştığı için
    burada da baytlar üzerinden dönüyoruz.
    """
    safe = "".join(chr(b) if chr(b) in ASCII_ALNUM else "_"
                   for b in ws_name.encode())
    return f"{RUNTIME}/qs-maximize.ws.{safe}"


def covered():
    """Ekranı gerçekten kaplayan bir şey var mı?

    İki durum: (1) görünür workspace'te tam ekran pencere, (2) görünür
    workspace'te boşluksuz mod (Super+H) AÇIK **ve** o workspace'te en az bir
    pencere var.
    DİKKAT: sadece boşluksuz moda bakmak yetmiyor — pencereler kapanınca ya da
    hiç pencere yokken duvar kağıdı görünür oluyor, o zaman duraklatılmamalı.
    DİKKAT: boşluksuz mod artık workspace başına (bkz. qs-maximize), o yüzden
    kontrol de workspace başına. Boşluğu kapalı bir workspace'ten boşluğu açık
    olana geçince duvar kağıdı kaldığı yerden devam etmeli.
    """
    try:
        mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"],
                                         capture_output=True, text=True).stdout)
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"],
                                            capture_output=True, text=True).stdout)
    except (ValueError, OSError):
        return False

    visible = {}
    for m in mons:
        ws = m.get("activeWorkspace") or {}
        if ws.get("name"):
            visible[ws["id"]] = ws["name"]

    legacy = os.path.exists(LEGACY_STATE)

    for ws_id, ws_name in visible.items():
        on_ws = [c for c in clients if c["workspace"]["id"] == ws_id]
        if not on_ws:
            continue
        if any(c.get("fullscreen", 0) for c in on_ws):
            return True
        if legacy or os.path.exists(state_path(ws_name)):
            return True
    return False


def main():
    # qs-maximize boşluksuz modu açıp kapatınca Hyprland olayı üretmiyor,
    # bu yüzden tek seferlik yeniden değerlendirme için çağırıyor
    if "--once" in sys.argv:
        mpv(covered())
        return

    state = None
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.connect(EVENTS)
    except OSError as exc:
        sys.exit(f"qs-wallpaper-watch: olay soketine bağlanılamadı ({exc})")

    mpv(covered())
    buf = b""
    while True:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            if not line.decode(errors="replace").startswith(WATCHED):
                continue
            now = covered()
            if now != state:
                state = now
                mpv(now)


if __name__ == "__main__":
    main()
