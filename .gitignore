config/hypr/hyprpaper.conf
config/hypr/config/theme.lua
config/kitty/current-theme.conf
config/kitty/*-theme.auto.conf
config/btop/themes/qs-*
config/Kvantum/qs-*
config/Kvantum/kvantum.kvconfig
config/gtk-3.0/gtk.css
config/gtk-4.0/gtk.css

# kişisel durum
config/quickshell/favorites.json
config/quickshell/clipboard-pins.json
config/quickshell/wallpapers.conf
config/quickshell/wallpaper.txt
# Control centre toggles — qs-settings yazıyor, yokken hepsi açık sayılıyor
config/quickshell/settings.json
# Bar widget toggles — BarSettings.qml yazıyor, yokken hepsi açık (cava hariç)
config/quickshell/bar.json

# çöp
**/.venv/
**/__pycache__/
**/node_modules/
*.pyc

# Duvar kağıtları wallpapers.zip olarak giriyor (qs-export üretiyor).
# Açılmış klasör yanlışlıkla eklenmesin:
wallpapers/

# qs-theme-hyprlock üretiyor (arka plan yüzlerce KB)
