[global]

    # ---------------- GENERAL ----------------

    width = 380
    height = (0, 400)

    origin = top-right
    offset = (15, 15)

    gap_size = 8

    timeout = 5s

    # Topbar'daki bildirim merkezi geçmişi buradan okuyor; varsayılan 20 çok azdı
    history_length = 100

    background = "#e8f4fb"
    foreground = "#10333f"

    frame_width = 2
    frame_color = "#0a84c8"

    corner_radius = 12

    font = "MonaspiceAr Nerd Font Bold 11"


# ---------------- ICON ----------------

    icon_position = left

    min_icon_size = 48
    max_icon_size = 48

    icon_theme = Papirus-Dark

icon_path = /usr/share/icons/Papirus-Dark/48x48/apps:/usr/share/icons/Papirus-Dark/48x48/status:/usr/share/icons/Papirus-Dark/48x48/devices:/usr/share/icons/Papirus-Dark/32x32/apps:/usr/share/icons/Papirus-Dark/32x32/status:/usr/share/icons/Papirus-Dark/32x32/devices:/usr/share/icons/Papirus-Dark/24x24/apps:/usr/share/icons/Papirus-Dark/24x24/status:/usr/share/icons/Papirus-Dark/24x24/devices:/usr/share/icons/Papirus-Dark/16x16/apps:/usr/share/icons/Papirus-Dark/16x16/status:/usr/share/icons/Papirus-Dark/16x16/devices

    # ---------------- TEXT ----------------

    markup = full

    format = "<b>%s</b>\n%b"

    # Eylemi olan bildirimlerdeki "(A)" işaretini gizle — hatırlatmalarda
    # zaten gövdede "[ Önizle ]" butonu var
    show_indicators = false

    alignment = left
    vertical_alignment = center

    padding = 12
    horizontal_padding = 12


    # ---------------- PROGRESS BAR ----------------

    progress_bar = true

    progress_bar_height = 4
    progress_bar_frame_width = 0

    progress_bar_min_width = 100
    progress_bar_max_width = 356


    # ---------------- MOUSE ----------------

    # do_action: bildirimin varsayılan eylemini çalıştırır (takvim
    # hatırlatmalarındaki "Önizle" butonu buna bağlı). Eylemi olmayan
    # bildirimlerde sadece kapatır.
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current


# ============================================================
# LOW URGENCY
# ============================================================

[urgency_low]

    background = "#e8f4fb"
    foreground = "#2f5a6e"

    frame_color = "#7fb0c9"

    timeout = 3s


# ============================================================
# NORMAL URGENCY
# ============================================================

[urgency_normal]

    background = "#e8f4fb"
    foreground = "#10333f"

    frame_color = "#0a84c8"
    highlight = "#0a84c8"

    timeout = 5s


# ============================================================
# CRITICAL URGENCY
# ============================================================

[urgency_critical]

    background = "#e8f4fb"
    foreground = "#e5484d"

    frame_color = "#e5484d"

    timeout = 0

[forward_all_notifications]

    script = /home/mrlemon/.local/bin/dunst-forward
    format = ""


[proxy_notifications]

    appname = "DunstProxy"
    format = "<b>%s</b>\n%b"


# Takvim hatırlatmaları: DunstProxy adıyla gönderiliyor ki forward script'i
# atlasın, kategoriyle ayırt edilip tıklanana kadar ekranda kalıyor.

[qs_reminder]

    appname = "DunstProxy"
    category = "qs.reminder"

    format = "<b>%s</b>\n%b"

    timeout = 0

    # Not defteri ikonunu qs-note-reminder yolluyor, geri sayım çubuğu yok
    progress_bar = false

    frame_color = "#1e88e5"
    highlight = "#1e88e5"
